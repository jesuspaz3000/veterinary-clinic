# ---------------------------------------------------------------------------
# VetGest - variables de entorno para docker-compose
#
# Copia este archivo a ".env" (mismo directorio que docker-compose.yml) y
# rellena los valores reales. El archivo ".env" NO se sube a git.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Puertos expuestos en el host ---
# Ajusta si ya están ocupados por otro contenedor en el servidor.
BACKEND_PORT=8081
FRONTEND_PORT=3002

# --- Base de datos (Postgres) ---
DB_NAME=vet_db
DB_USER=postgres
DB_PASSWORD=cambia-esta-clave

# --- Backend (Spring Boot) ---

# Secreto usado para firmar los JWT. Genera uno nuevo y NO reutilices el de
# desarrollo local. Puedes generarlo con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-generado-con-openssl-rand-hex-32

# URL pública por la que el backend será accesible (se usa para construir las
# URLs de las imágenes servidas desde /api/uploads).
# Ejemplo: http://IP_DEL_SERVIDOR:8081  o  https://api.tudominio.com
APP_BASE_URL=http://IP_DEL_SERVIDOR:8081

# Orígenes permitidos por CORS: la URL pública del frontend.
# Varios orígenes se separan por coma.
# Ejemplo: http://IP_DEL_SERVIDOR:3002
CORS_ALLOWED_ORIGINS=http://IP_DEL_SERVIDOR:3002

# Cookie del refresh token.
# AUTH_COOKIE_SECURE=true solo si el frontend se sirve por HTTPS (ej. detrás
# de un proxy con TLS). Si pruebas por IP/HTTP plano, déjalo en false.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=

# Usuario superadmin que se crea automáticamente la primera vez que arranca
# el backend (solo si no existe ya un usuario con ese email).
SUPERADMIN_EMAIL=admin@tudominio.com
SUPERADMIN_PASSWORD=cambia-esta-clave

# --- Frontend (Next.js) ---

# IMPORTANTE: esta variable se incrusta en el build del frontend (no es una
# variable de runtime). Si la cambias hay que reconstruir la imagen:
#   docker compose build frontend && docker compose up -d frontend
# Debe ser la misma URL pública del backend (APP_BASE_URL) + "/api".
NEXT_PUBLIC_APP_URL=http://IP_DEL_SERVIDOR:8081/api
